# Copier en .env.local pour le développement (facultatif : sans mot de passe, pas d'authentification en local)

# Comptes
PAIE_MOT_DE_PASSE=
PAIE_MOT_DE_PASSE_ADMIN=
AUTH_SECRET=                 # openssl rand -base64 32

# Stockage : Postgres (Neon) si défini, sinon fichier data/paie.json
DATABASE_URL=
PAIE_DONNEES_INITIALES=      # demo | vide (par défaut : vide en production, demo ailleurs)

# Mises à jour (production uniquement)
GITHUB_REPO=samben80/bio-tracker
GITHUB_TOKEN=                # jeton fin : Contents en lecture/écriture sur le dépôt
PAIE_BRANCHE_PRODUCTION=production
VERCEL_DEPLOY_HOOK_URL=      # facultatif, si la production n'est pas redéployée automatiquement
